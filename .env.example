# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=1092164380

# SQLite база даних
DATABASE_PATH=bot_database.sqlite

# ==========================================
# LLM API (OpenAI, OpenRouter, Gemini, Groq)
# ==========================================
# Можна використовувати будь-який сумісний провайдер:
# 1. OpenAI: https://api.openai.com/v1 (моделі: gpt-4o-mini, gpt-4o)
# 2. OpenRouter: https://openrouter.ai/api/v1 (моделі: openai/gpt-4o-mini, anthropic/claude-3.5-haiku)
# 3. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ (моделі: gemini-1.5-flash)
LLM_API_KEY=your_openai_or_openrouter_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.72
LLM_TIMEOUT_SECONDS=35.0

# ==========================================
# ЦІНИ TELEGRAM STARS (XTR)
# ==========================================
TAROT_PRICE_1=35
TAROT_PRICE_3=90
ARCANA_LOVE_PRICE=35

# ==========================================
# ЛІМІТИ ТА СЕРВЕР
# ==========================================
COMPATIBILITY_DAILY_LIMIT=3
PORT=10000
