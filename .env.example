# Токен вашего бота из @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Ваш числовой Telegram ID (узнать можно в @userinfobot)
# Если администраторов несколько, можно указать через запятую: 123456789,987654321
ADMIN_IDS=123456789

# Путь к файлу базы данных SQLite
DATABASE_PATH=bot_database.sqlite
