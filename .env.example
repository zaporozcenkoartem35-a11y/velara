# ==========================================
# TELEGRAM BOT CONFIGURATION
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=1092164380

# ==========================================
# БАЗА ДАНИХ (RENDER / POSTGRESQL / SQLITE)
# ==========================================
# Для Render або хмарних БД вкажіть DATABASE_URL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
# Якщо DATABASE_URL не задано, бот автоматично використовує локальний SQLite:
DATABASE_URL=
DATABASE_PATH=bot_database.sqlite

# ==========================================
# LLM API (OpenAI, OpenRouter, Gemini, Groq)
# ==========================================
# Провайдери:
# 1. OpenRouter (Рекомендовано для найвищої якості):
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_MODEL=anthropic/claude-3.5-sonnet
# 2. OpenAI:
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_MODEL=gpt-4o
# 3. Google Gemini (швидкий та дешевий):
#    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#    LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_openai_or_openrouter_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE=0.72
LLM_MAX_TOKENS=650
LLM_TIMEOUT_SECONDS=30.0

# ==========================================
# ЦІНИ TELEGRAM STARS (XTR)
# ==========================================
PRICE_TAROT_1=35
PRICE_TAROT_3=90
PRICE_ARCANA_LOVE=35
PRICE_COMPAT=25
PRICE_COMPAT_STARS=25

# ==========================================
# ПІДТРИМКА ТА НАЛАШТУВАННЯ ІНТЕРФЕЙСУ
# ==========================================
SUPPORT_USERNAME=VelaraSupport
ENABLE_WEBAPP=false
PORT=10000
